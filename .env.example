# Copie este arquivo para ".env" e preencha os valores.
# ".env" nunca é commitado (ver .gitignore) — nenhuma credencial vai pro git.

# Painel web (Bloco 2) — por padrão só localhost, sem exposição externa
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Bot do Telegram (Bloco 3) — token gerado pelo BotFather
TELEGRAM_BOT_TOKEN=

# OddsPapi (Bloco 5) — chave da API (plano gratuito, 250 usos)
ODDSPAPI_KEY=
